# Copy this file to .env.local (gitignored) and fill in real values.
# These are all public/client-safe values by design:
#  - VITE_SUPABASE_ANON_KEY is Supabase's anon/public key. Safety comes
#    from the Row Level Security policies in supabase/migrations/, not
#    from keeping this key secret — it's meant to be shipped to the browser,
#    the same way a Stripe publishable key is.
#  - VITE_PENDO_API_KEY is Pendo's public subscription/agent key.
#
# NEVER put a Supabase *service_role* key in a VITE_-prefixed variable —
# Vite inlines VITE_ vars into the shipped browser bundle. The service_role
# key is only ever used locally by app/scripts/seed-demo-account.mjs, via
# a plain (non-VITE_) shell env var, and must never be committed anywhere.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_PENDO_API_KEY=your-pendo-subscription-agent-key-here
